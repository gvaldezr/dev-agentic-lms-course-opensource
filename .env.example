# LLM endpoint
# Proveedor LLM: "ollama" (local/remoto) u "openai" (API de OpenAI o compatible)
LLM_PROVIDER=ollama
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Example for Ollama remote host:
# LLM_PROVIDER=ollama
# LLM_API_URL=http://10.0.11.7:11434/api/chat
# LLM_MODEL=gemma4
# LLM_API_KEY=

# Example for OpenAI API (LLM_API_URL es opcional; usa el endpoint oficial por defecto):
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# Image generation endpoint (Stable Diffusion compatible custom endpoint)
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_TIMEOUT_SECONDS=90
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# OpenAlex
OPENALEX_API_KEY=

# Runtime options
OUTPUT_DIR=./data/output
LOG_LEVEL=INFO
